# Copy ke .env: cp .env.example .env  (jangan commit .env)

# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=4301
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORKER_URL=http://localhost:4302
# gateway <-> worker, generate: openssl rand -hex 32
API_INTERNAL_TOKEN=

# ── Infra ───────────────────────────────────────────
DATABASE_URL="postgresql://seougc:seougc@localhost:55432/seougc"
REDIS_URL="redis://localhost:6379"

# ── AI: dua provider terpisah per peran (tanpa fallback antar peran) ──
# STT provider (transcribe audio), contoh: https://api.openai.com/v1
AI_STT_BASE_URL=
AI_STT_API_KEY=
AI_STT_MODEL=

# LLM provider (seleksi gambar + artikel + JSON-LD)
# contoh: https://inference.baseten.co/v1 | https://api.fireworks.ai/inference/v1
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=

# ── Object storage (S3 / R2) ────────────────────────
# kosong = upload gambar dilewati (Artikel.images = []); isi lengkap = wajib sukses
S3_BUCKET_NAME=seo-ugc-images
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Guardrails ──────────────────────────────────────
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=180
RATE_LIMIT_PER_MIN=5

# opsional: cookie jar Netscape untuk yt-dlp (TikTok/IG sering minta login)
YTDLP_COOKIES_FILE=

# web -> api
API_BASE_URL=http://localhost:4301
