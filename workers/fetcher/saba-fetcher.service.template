[Unit]
Description=SABA fetch-worker lokal (jam kerja)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO
EnvironmentFile=%h/.config/saba-fetcher.env
ExecStart=@REPO/workers/processor/.venv/bin/python workers/fetcher/fetch.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
