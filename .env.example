# Copy ke .env: cp .env.example .env  (jangan commit .env)

# ── App ─────────────────────────────────────────────
NODE_ENV=development
PORT=4301
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
WORKER_URL="http://localhost:4302"
# gateway <-> worker, generate: openssl rand -hex 32
API_INTERNAL_TOKEN=

# ── Infra ───────────────────────────────────────────
# Postgres 16: lokal via Docker (port 55432) | server: container saba-pg
# Contoh: postgresql://seougc:seougc@localhost:55432/seougc
DATABASE_URL="postgresql://seougc:seougc@localhost:55432/seougc"
# Antrean BullMQ (wajib): lokal redis://localhost:6379, server redis://localhost:6379
REDIS_URL="redis://localhost:6379"
# Upload video langsung (server olah, video dihapus setelah jadi artikel)
# server: /opt/saba/media
MEDIA_DIR="./data/media"

# ── AI: dua provider terpisah per peran (tanpa fallback antar peran) ──
# STT provider (transcribe audio), contoh: https://api.openai.com/v1
# AI_STT_MODE: openai (default, /audio/transcriptions) atau meta-asr
#   (meta-asr: AI_STT_BASE_URL = URL endpoint penuh …/v1/asr/transcribe,
#   audio dikonversi ke WAV 16kHz mono otomatis)
AI_STT_MODE=
AI_STT_BASE_URL=
AI_STT_API_KEY=
AI_STT_MODEL=

# LLM provider (seleksi gambar + artikel + JSON-LD)
# contoh: https://inference.baseten.co/v1 | https://api.fireworks.ai/inference/v1
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=

LOCAL_IMAGE_DIR=
LOCAL_PUBLIC_BASE_URL=
S3_BUCKET_NAME=seo-ugc-images
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Guardrails ──────────────────────────────────────
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=180
# worker paralel BullMQ (harian: 2, demo: 4, maks: 32 — butuh RAM/CPU cukup)
WORKER_CONCURRENCY=2
RATE_LIMIT_PER_MIN=5
# vote forum: 30/menit per IP
RATE_LIMIT_VOTE_PER_MIN=30

# web -> api
API_BASE_URL=http://localhost:4301
